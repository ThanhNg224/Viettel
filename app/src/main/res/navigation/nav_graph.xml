<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/serviceEvaluationFragment">

    <fragment
        android:id="@+id/serviceEvaluationFragment"
        android:name="com.example.viettel.fragments.ServiceEvaluationFragment"
        android:label="ServiceEvaluationFragment">

        <action
            android:id="@+id/action_serviceEvaluationFragment_to_feedbackFragment"
            app:destination="@id/feedbackFragment" />
    </fragment>

    <fragment
        android:id="@+id/feedbackFragment"
        android:name="com.example.viettel.fragments.FeedbackFragment"
        android:label="FeedbackFragment">

        <action
            android:id="@+id/action_feedbackFragment_to_endFragment"
            app:destination="@id/action_feedbackFragment_to_endFragment" />
    </fragment>

</navigation>
