<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardViewStep6"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Header with progress bar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:padding="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvDocumentTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Xác thực thông tin"
                android:textColor="@android:color/black"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/progressBarContainer"
                app:layout_constraintHorizontal_weight="1.5" />

            <!-- Gray track line -->
            <View
                android:id="@+id/trackLine"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:background="@android:color/darker_gray"
                app:layout_constraintStart_toStartOf="@+id/progressBarContainer"
                app:layout_constraintEnd_toEndOf="@+id/progressBarContainer"
                app:layout_constraintTop_toTopOf="@+id/progressBarContainer"
                app:layout_constraintBottom_toBottomOf="@+id/progressBarContainer"
                app:layout_constraintVertical_bias="0.3" />

            <!-- Red progress line -->
            <View
                android:id="@+id/progressLine"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:background="@android:color/holo_red_light"
                app:layout_constraintStart_toStartOf="@+id/progressBarContainer"
                app:layout_constraintTop_toTopOf="@+id/progressBarContainer"
                app:layout_constraintBottom_toBottomOf="@+id/progressBarContainer"
                app:layout_constraintVertical_bias="0.3" />

            <!-- Steps container -->
            <LinearLayout
                android:id="@+id/progressBarContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvDocumentTitle"
                app:layout_constraintHorizontal_weight="2">

                <!-- Step 1: Chọn giấy tờ (red tick) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/circle_redtick" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chọn giấy tờ"
                        android:textSize="10sp"
                        android:textColor="@color/black"
                        android:gravity="center"/>
                </LinearLayout>

                <!-- Step 2: Đặt giấy tờ (red tick) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/circle_redtick" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đặt giấy tờ"
                        android:textSize="10sp"
                        android:textColor="@color/black"
                        android:gravity="center"/>
                </LinearLayout>

                <!-- Step 3: Chụp ảnh trước (red tick) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/circle_redtick" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chụp ảnh trước"
                        android:textSize="10sp"
                        android:textColor="@color/black"
                        android:gravity="center"/>
                </LinearLayout>

                <!-- Step 4: Chụp ảnh sau -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/circle_redtick" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chụp ảnh sau"
                        android:textSize="10sp"
                        android:textColor="@color/black"
                        android:gravity="center"/>
                </LinearLayout>

                <!-- Step 5: Quét chip -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/circle_redtick" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quét chip"
                        android:textSize="10sp"
                        android:textColor="@color/black"
                        android:gravity="center"/>
                </LinearLayout>

                <!-- Step 6: Chân dung -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/circle_redtick" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chân dung"
                        android:textSize="10sp"
                        android:textColor="@color/black"
                        android:gravity="center"/>
                </LinearLayout>

                <!-- Step 7: Thanh toán -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/circle_border1" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thanh toán"
                        android:textSize="10sp"
                        android:textColor="@color/black"
                        android:gravity="center"/>
                </LinearLayout>

                <!-- Step 8: Khảo sát -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:orientation="vertical"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/circle_border1" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Khảo sát"
                        android:textSize="10sp"
                        android:textColor="@color/black"
                        android:gravity="center"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Content: chip comparison split layout -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardContent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#F7F7F7"
            android:padding="10dp"
            app:layout_constraintTop_toBottomOf="@id/cardHeader"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Split: Left = comparison, Right = ID info -->
            <LinearLayout
                android:id="@+id/comparisonWrapper"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Left side (Big) -->
                <LinearLayout
                    android:id="@+id/leftComparison"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:orientation="vertical"
                    android:background="#FFEEEE"
                    android:padding="16dp"
                    android:gravity="center"
                    >

                    <TextView
                        android:id="@+id/txtMatchResult"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chân dung khách hàng và giấy tờ: trùng khớp ...%"
                        android:textColor="#2E7D32"
                        android:textSize="25sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/imgSmilePortrait"
                            android:layout_width="240dp"
                            android:layout_height="320dp"
                            android:layout_marginEnd="16dp"
                            android:scaleType="centerCrop"
                            android:background="@android:color/darker_gray" />

                        <ImageView
                            android:id="@+id/imgChipPortrait"
                            android:layout_width="240dp"
                            android:layout_height="320dp"
                            android:scaleType="centerCrop"
                            android:background="@android:color/darker_gray" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Right side (Small) -->
                <LinearLayout
                    android:id="@+id/rightChipStatus"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="#E0E0E0"
                    android:gravity="center"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/txtChipSuccess"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đọc thông tin trên chip thành công"
                        android:textColor="#000"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <ImageView
                        android:id="@+id/imgIdFront"
                        android:layout_width="280dp"
                        android:layout_height="176dp"
                        android:scaleType="fitCenter"
                        android:layout_marginBottom="12dp"
                        android:background="@android:color/darker_gray" />

                    <ImageView
                        android:id="@+id/imgTickSuccess"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_success_tick"
                         />
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
