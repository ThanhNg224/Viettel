<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Header -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@android:color/white"
                android:padding="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Title -->
                <TextView
                    android:id="@+id/tvDocumentTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Khảo sát"
                    android:textColor="@android:color/black"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/progressBarContainer"
                    app:layout_constraintHorizontal_weight="1.5" />

                <!-- Track line & Progress line -->
                <View
                    android:id="@+id/trackLine"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:background="@android:color/darker_gray"
                    app:layout_constraintStart_toStartOf="@id/progressBarContainer"
                    app:layout_constraintEnd_toEndOf="@id/progressBarContainer"
                    app:layout_constraintTop_toTopOf="@id/progressBarContainer"
                    app:layout_constraintBottom_toBottomOf="@id/progressBarContainer"
                    app:layout_constraintVertical_bias="0.3" />

                <View
                    android:id="@+id/progressLine"
                    android:layout_width="1dp"
                    android:layout_height="6dp"
                    android:background="@android:color/holo_red_light"
                    app:layout_constraintStart_toStartOf="@id/progressBarContainer"
                    app:layout_constraintTop_toTopOf="@id/progressBarContainer"
                    app:layout_constraintBottom_toBottomOf="@id/progressBarContainer"
                    app:layout_constraintVertical_bias="0.3" />

                <!-- Steps -->
                <LinearLayout
                    android:id="@+id/progressBarContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvDocumentTitle"
                    app:layout_constraintHorizontal_weight="2">

                    <!-- Step 1: Chọn giấy tờ (red tick) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginBottom="4dp"
                            android:background="@drawable/circle_redtick" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chọn giấy tờ"
                            android:textSize="10sp"
                            android:textColor="@color/black"
                            android:gravity="center"/>
                    </LinearLayout>

                    <!-- Step 2: Đặt giấy tờ (red tick) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginBottom="4dp"
                            android:background="@drawable/circle_redtick" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đặt giấy tờ"
                            android:textSize="10sp"
                            android:textColor="@color/black"
                            android:gravity="center"/>
                    </LinearLayout>

                    <!-- Step 3: Chụp ảnh trước (red tick) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginBottom="4dp"
                            android:background="@drawable/circle_redtick" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chụp ảnh trước"
                            android:textSize="10sp"
                            android:textColor="@color/black"
                            android:gravity="center"/>
                    </LinearLayout>

                    <!-- Step 4: Chụp ảnh sau -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginBottom="4dp"
                            android:background="@drawable/circle_redtick" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chụp ảnh sau"
                            android:textSize="10sp"
                            android:textColor="@color/black"
                            android:gravity="center"/>
                    </LinearLayout>

                    <!-- Step 5: Quét chip -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginBottom="4dp"
                            android:background="@drawable/circle_redtick" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quét chip"
                            android:textSize="10sp"
                            android:textColor="@color/black"
                            android:gravity="center"/>
                    </LinearLayout>

                    <!-- Step 6: Chân dung -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginBottom="4dp"
                            android:background="@drawable/circle_redtick" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chân dung"
                            android:textSize="10sp"
                            android:textColor="@color/black"
                            android:gravity="center"/>
                    </LinearLayout>

                    <!-- Step 7: Thanh toán -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginBottom="4dp"
                            android:background="@drawable/circle_redtick" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Thanh toán"
                            android:textSize="10sp"
                            android:textColor="@color/black"
                            android:gravity="center"/>
                    </LinearLayout>

                    <!-- Step 8: Khảo sát -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginBottom="4dp"
                            android:background="@drawable/circle_redtick" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Khảo sát"
                            android:textSize="10sp"
                            android:textColor="@color/black"
                            android:gravity="center"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardContent"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="#FFEEEE"
                android:padding="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardHeader"
                app:layout_constraintVertical_bias="0.0">

                <TextView
                    android:id="@+id/tvInstruction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="Cảm ơn quý khách đã tham gia khảo sát"
                    android:textColor="@android:color/black"
                    android:textSize="30dp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Danh sách checkbox -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layoutCheckboxes"
                    android:layout_width="700dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvInstruction">

                    <!-- Checkbox 1 -->
                    <LinearLayout
                        android:id="@+id/checkBox1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/border_box"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        app:layout_constraintTop_toTopOf="parent">


                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:text="Tính năng khó sử dụng"
                            android:textColor="#000000"
                            android:textSize="20dp" />

                        <CheckBox
                            android:id="@+id/checkbox_reason_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/red" />
                    </LinearLayout>

                    <!-- Checkbox 2 -->
                    <LinearLayout
                        android:id="@+id/checkBox2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:background="@drawable/border_box"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        app:layout_constraintTop_toBottomOf="@id/checkBox1">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:text="Thông tin về sản phẩm, dịch vụ không rõ ràng"
                            android:textColor="#000000"
                            android:textSize="20dp" />

                        <CheckBox
                            android:id="@+id/checkbox_reason_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/red" />
                    </LinearLayout>

                    <!-- Checkbox 3 -->
                    <LinearLayout
                        android:id="@+id/checkBox3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:background="@drawable/border_box"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        app:layout_constraintTop_toBottomOf="@id/checkBox2">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:text="Giao diện, bố cục sắp xếp chưa hợp lý"
                            android:textColor="#000000"
                            android:textSize="20dp" />

                        <CheckBox
                            android:id="@+id/checkbox_reason_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/red" />
                    </LinearLayout>

                    <!-- Checkbox 4 -->
                    <LinearLayout
                        android:id="@+id/checkBox4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:background="@drawable/border_box"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        app:layout_constraintTop_toBottomOf="@id/checkBox3">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:text="Thời gian phản hồi của ứng dụng chậm"
                            android:textColor="#000000"
                            android:textSize="20dp" />

                        <CheckBox
                            android:id="@+id/checkbox_reason_4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/red" />
                    </LinearLayout>

                    <!-- Checkbox 5 -->
                    <LinearLayout
                        android:id="@+id/checkBox5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:background="@drawable/border_box"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        app:layout_constraintTop_toBottomOf="@id/checkBox4">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:text="Lý do khác"
                            android:textColor="#000000"
                            android:textSize="20dp" />

                        <CheckBox
                            android:id="@+id/checkbox_reason_5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/red" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/editText_checkBox5"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="15dp"
                        android:background="@drawable/border_box"
                        android:hint=" Quý khách vui lòng đóng góp ý kiến để Viettel hoàn thiện chất lượng sản phẩm/ dịch vụ"
                        android:padding="12dp"
                        android:visibility="gone"
                        android:gravity="top|start"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@android:color/black"
                        android:textSize="15dp"
                        app:layout_constraintTop_toBottomOf="@id/checkBox5"/>


                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>