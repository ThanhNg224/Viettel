<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Header -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@android:color/white"
                android:padding="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Title -->
                <TextView
                    android:id="@+id/tvDocumentTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Thông tin đơn hàng"
                    android:textColor="@android:color/black"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/progressBarContainer"
                    app:layout_constraintHorizontal_weight="1.5" />

                <!-- Track line & Progress line -->
                <View
                    android:id="@+id/trackLine"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:background="@android:color/darker_gray"
                    app:layout_constraintStart_toStartOf="@id/progressBarContainer"
                    app:layout_constraintEnd_toEndOf="@id/progressBarContainer"
                    app:layout_constraintTop_toTopOf="@id/progressBarContainer"
                    app:layout_constraintBottom_toBottomOf="@id/progressBarContainer"
                    app:layout_constraintVertical_bias="0.3" />

                <View
                    android:id="@+id/progressLine"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:background="@android:color/holo_red_light"
                    app:layout_constraintStart_toStartOf="@id/progressBarContainer"
                    app:layout_constraintTop_toTopOf="@id/progressBarContainer"
                    app:layout_constraintBottom_toBottomOf="@id/progressBarContainer"
                    app:layout_constraintVertical_bias="0.3" />

                <!-- Steps -->
                <LinearLayout
                    android:id="@+id/progressBarContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvDocumentTitle"
                    app:layout_constraintHorizontal_weight="2">

                    <!-- Step 1: Chọn giấy tờ (red tick) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginBottom="4dp"
                            android:background="@drawable/circle_redtick" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chọn giấy tờ"
                            android:textSize="10sp"
                            android:textColor="@color/black"
                            android:gravity="center"/>
                    </LinearLayout>

                    <!-- Step 2: Đặt giấy tờ (red tick) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginBottom="4dp"
                            android:background="@drawable/circle_redtick" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đặt giấy tờ"
                            android:textSize="10sp"
                            android:textColor="@color/black"
                            android:gravity="center"/>
                    </LinearLayout>

                    <!-- Step 3: Chụp ảnh trước (red tick) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginBottom="4dp"
                            android:background="@drawable/circle_redtick" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chụp ảnh trước"
                            android:textSize="10sp"
                            android:textColor="@color/black"
                            android:gravity="center"/>
                    </LinearLayout>

                    <!-- Step 4: Chụp ảnh sau -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginBottom="4dp"
                            android:background="@drawable/circle_redtick" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chụp ảnh sau"
                            android:textSize="10sp"
                            android:textColor="@color/black"
                            android:gravity="center"/>
                    </LinearLayout>

                    <!-- Step 5: Quét chip -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginBottom="4dp"
                            android:background="@drawable/circle_redtick" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quét chip"
                            android:textSize="10sp"
                            android:textColor="@color/black"
                            android:gravity="center"/>
                    </LinearLayout>

                    <!-- Step 6: Chân dung -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginBottom="4dp"
                            android:background="@drawable/circle_redtick" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chân dung"
                            android:textSize="10sp"
                            android:textColor="@color/black"
                            android:gravity="center"/>
                    </LinearLayout>

                    <!-- Step 7: Thanh toán -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginBottom="4dp"
                            android:background="@drawable/circle_redtick" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Thanh toán"
                            android:textSize="10sp"
                            android:textColor="@color/black"
                            android:gravity="center"/>
                    </LinearLayout>

                    <!-- Step 8: Khảo sát -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginBottom="4dp"
                            android:background="@drawable/circle_border1" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Khảo sát"
                            android:textSize="10sp"
                            android:textColor="@color/black"
                            android:gravity="center"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Vùng nội dung bên dưới Header -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/content_area"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toBottomOf="@id/cardHeader"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- QrCode -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/namePaymentCard"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="#FFFFFF"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintWidth_percent="0.45">

                    <!-- Tiêu đề -->
                    <ImageView
                        android:id="@+id/qrScanImg"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintWidth_percent="0.55"
                        app:layout_constraintHeight_percent="0.55"
                        app:layout_constraintVertical_bias="0.1"
                        android:layout_margin="16dp"
                        android:src="@drawable/qrscan_image"
                        android:scaleType="centerCrop" />

                    <TextView
                        android:id="@+id/namePayment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@id/qrScanImg"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="25dp"
                        android:text="Thanh toán bằng QR Code"
                        android:textSize="30dp"
                        android:textColor="#333333"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@id/namePayment"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="25dp"
                        android:gravity="center"
                        android:maxWidth="500dp"
                        android:text="Quý khách vui lòng chọn tiếp tục để thanh toán bằng Qr Code"
                        android:textSize="22dp"
                        android:textStyle="bold"/>


                    <!-- CardView chứa nội dung đơn hàng -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/billInformation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintTop_toBottomOf="@id/namePayment"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                    </androidx.cardview.widget.CardView>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Method Payment -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/paymentCard"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="#F2F2F2"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toEndOf="@id/namePaymentCard"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.0"
                    app:layout_constraintWidth_percent="0.55">

                    <!-- Tiêu đề -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/totalBill"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginTop="40dp"
                        android:background="#FFFFFF"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvOrderInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Thanh toán đơn hàng 15263773883838"
                            android:textColor="#000000"
                            android:textSize="16sp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            android:layout_marginStart="20dp" />

                        <!-- Số tiền -->
                        <TextView
                            android:id="@+id/tvAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="220.000 VNĐ"
                            android:textColor="#D90000"
                            android:textStyle="bold"
                            android:textSize="22sp"
                            app:layout_constraintTop_toBottomOf="@id/tvOrderInfo"
                            app:layout_constraintStart_toStartOf="parent"
                            android:layout_marginStart="20dp"
                            android:layout_marginTop="8dp"/>

                        <ImageView
                            android:id="@+id/statusTick"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginTop="4dp"
                            android:visibility="gone"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.8"
                            android:src="@drawable/ic_success_tick"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- CardView chứa nội dung đơn hàng -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/paymentOptions"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="25dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/totalBill"
                        app:layout_constraintVertical_bias="0.0">

                        <TextView
                            android:id="@+id/qrCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quét mã QR sau đây để thanh toán"
                            android:textColor="#333333"
                            android:textSize="30dp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                        <LinearLayout
                            android:id="@+id/paymentStatusLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="#F2F2F2"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:padding="8dp"
                            android:visibility="gone"
                            app:layout_constraintBottom_toBottomOf="@id/qrCode"
                            app:layout_constraintEnd_toEndOf="@id/qrCode"
                            app:layout_constraintStart_toStartOf="@id/qrCode"
                            app:layout_constraintTop_toTopOf="@id/qrCode">

                            <TextView
                                android:id="@+id/tvPaymentSuccess"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Thanh toán thành công"
                                android:textSize="30dp"
                                android:textStyle="bold"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>
                        </LinearLayout>

                        <!-- Dòng phụ khi thất bại -->
                        <TextView
                            android:id="@+id/statusSubText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Không có phản hồi của ngân hàng thụ hưởng, vui lòng thử lại sau"
                            android:textColor="#FF000000"
                            android:textSize="18dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/qrCode"
                            android:layout_marginTop="10dp"
                            android:visibility="gone"/>

                        <androidx.cardview.widget.CardView
                            android:layout_width="200dp"
                            android:layout_height="200dp"
                            app:cardCornerRadius="40dp"
                            app:cardElevation="4dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHeight_percent="0.55"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/qrCode"
                            app:layout_constraintVertical_bias="0.22"
                            app:layout_constraintWidth_percent="0.55">

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:scaleType="centerCrop"
                                android:src="@drawable/qr_bg" />
                        </androidx.cardview.widget.CardView>

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>