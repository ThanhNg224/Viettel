<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Header -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@android:color/white"
                android:padding="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Title -->
                <TextView
                    android:id="@+id/tvDocumentTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Thông tin đơn hàng"
                    android:textColor="@android:color/black"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/progressBarContainer"
                    app:layout_constraintHorizontal_weight="1.5" />

                <!-- Track line & Progress line -->
                <View
                    android:id="@+id/trackLine"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:background="@android:color/darker_gray"
                    app:layout_constraintStart_toStartOf="@id/progressBarContainer"
                    app:layout_constraintEnd_toEndOf="@id/progressBarContainer"
                    app:layout_constraintTop_toTopOf="@id/progressBarContainer"
                    app:layout_constraintBottom_toBottomOf="@id/progressBarContainer"
                    app:layout_constraintVertical_bias="0.3" />

                <View
                    android:id="@+id/progressLine"
                    android:layout_width="1dp"
                    android:layout_height="6dp"
                    android:background="@android:color/holo_red_light"
                    app:layout_constraintStart_toStartOf="@id/progressBarContainer"
                    app:layout_constraintTop_toTopOf="@id/progressBarContainer"
                    app:layout_constraintBottom_toBottomOf="@id/progressBarContainer"
                    app:layout_constraintVertical_bias="0.3" />

                <!-- Steps -->
                <LinearLayout
                    android:id="@+id/progressBarContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvDocumentTitle"
                    app:layout_constraintHorizontal_weight="2">

                    <!-- Step 1: Chọn giấy tờ (red tick) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginBottom="4dp"
                            android:background="@drawable/circle_redtick" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chọn giấy tờ"
                            android:textSize="10sp"
                            android:textColor="@color/black"
                            android:gravity="center"/>
                    </LinearLayout>

                    <!-- Step 2: Đặt giấy tờ (red tick) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginBottom="4dp"
                            android:background="@drawable/circle_redtick" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đặt giấy tờ"
                            android:textSize="10sp"
                            android:textColor="@color/black"
                            android:gravity="center"/>
                    </LinearLayout>

                    <!-- Step 3: Chụp ảnh trước (red tick) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginBottom="4dp"
                            android:background="@drawable/circle_redtick" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chụp ảnh trước"
                            android:textSize="10sp"
                            android:textColor="@color/black"
                            android:gravity="center"/>
                    </LinearLayout>

                    <!-- Step 4: Chụp ảnh sau -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginBottom="4dp"
                            android:background="@drawable/circle_redtick" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chụp ảnh sau"
                            android:textSize="10sp"
                            android:textColor="@color/black"
                            android:gravity="center"/>
                    </LinearLayout>

                    <!-- Step 5: Quét chip -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginBottom="4dp"
                            android:background="@drawable/circle_redtick" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quét chip"
                            android:textSize="10sp"
                            android:textColor="@color/black"
                            android:gravity="center"/>
                    </LinearLayout>

                    <!-- Step 6: Chân dung -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginBottom="4dp"
                            android:background="@drawable/circle_redtick" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chân dung"
                            android:textSize="10sp"
                            android:textColor="@color/black"
                            android:gravity="center"/>
                    </LinearLayout>

                    <!-- Step 7: Thanh toán -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginBottom="4dp"
                            android:background="@drawable/circle_redtick" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Thanh toán"
                            android:textSize="10sp"
                            android:textColor="@color/black"
                            android:gravity="center"/>
                    </LinearLayout>

                    <!-- Step 8: Khảo sát -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginBottom="4dp"
                            android:background="@drawable/circle_border1" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Khảo sát"
                            android:textSize="10sp"
                            android:textColor="@color/black"
                            android:gravity="center"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Vùng nội dung bên dưới Header -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/content_area"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toBottomOf="@id/cardHeader"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Bill -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/billCard"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="#F2F2F2"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintWidth_percent="0.45">

                    <!-- Tiêu đề -->
                    <TextView
                        android:id="@+id/billTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thông tin đơn hàng"
                        android:textSize="30dp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="16dp"/>

                    <!-- CardView chứa nội dung đơn hàng -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/billInformation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintTop_toBottomOf="@id/billTitle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <!-- Nền mờ phía sau -->
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/bill_background"
                                android:scaleType="centerCrop"
                                android:alpha="0.15" />

                            <!-- Nội dung thông tin đơn hàng -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp"
                                android:gravity="center_vertical">

                                <!-- Dòng 1: Dịch vụ -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:paddingVertical="8dp">

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="Dịch vụ"
                                        android:textSize="16sp"
                                        android:textColor="#000000" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Mua Sim trả trước"
                                        android:textSize="16sp"
                                        android:textColor="#000000" />
                                </LinearLayout>

                                <!-- Dòng 2: Gói cước -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:paddingVertical="8dp">

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="Gói cước"
                                        android:textSize="16sp"
                                        android:textColor="#000000" />

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:gravity="center_vertical">

                                        <ImageView
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:src="@drawable/viettel_telecom_logo"
                                            android:layout_marginEnd="4dp" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="V200N"
                                            android:textSize="16sp"
                                            android:textColor="#000000"
                                            android:textStyle="bold" />
                                    </LinearLayout>
                                </LinearLayout>

                                <!-- Dòng 3: Tổng phí -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:paddingVertical="8dp">

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="Tổng phí"
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        android:textColor="#FF0000" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="1.000.000"
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        android:textColor="#FF0000" />
                                </LinearLayout>
                            </LinearLayout>
                        </FrameLayout>
                    </androidx.cardview.widget.CardView>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Method Payment -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/methodCard"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="#F2F2F2"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toEndOf="@id/billCard"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="0.0"
                    app:layout_constraintWidth_percent="0.55">

                    <!-- Tiêu đề -->
                    <TextView
                        android:id="@+id/methodTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Hình thức thanh toán"
                        android:textColor="#333333"
                        android:textSize="30dp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toTopOf="@id/paymentOptions"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- CardView chứa nội dung đơn hàng -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/paymentOptions"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="25dp"
                        app:layout_constraintTop_toBottomOf="@id/methodTitle"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <!-- QR Option as button -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/qrOptionCard"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_margin="8dp"
                            app:cardBackgroundColor="@android:color/white"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="4dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/cashOptionCard"
                            app:layout_constraintHeight_percent="0.45"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintWidth_percent="0.5"
                            app:layout_constraintVertical_bias="0.1">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="8dp">

                                <ImageView
                                    android:id="@+id/imgQrOption"
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    android:padding="16dp"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/qr_bg"
                                    app:layout_constraintBottom_toTopOf="@id/textQrOption"
                                    app:layout_constraintDimensionRatio="1:1"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintWidth_percent="0.6" />

                                <TextView
                                    android:id="@+id/textQrOption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:text="QR Code"
                                    android:textColor="@color/black"
                                    android:textSize="20dp"
                                    android:textStyle="bold"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@id/imgQrOption" />
                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- Cash Option as button -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/cashOptionCard"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            app:layout_constraintHeight_percent="0.45"
                            android:layout_margin="8dp"
                            app:cardBackgroundColor="@android:color/white"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="4dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/qrOptionCard"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintWidth_percent="0.5"
                            app:layout_constraintVertical_bias="0.1">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="8dp">

                                <ImageView
                                    android:id="@+id/imgCashOption"
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    android:padding="16dp"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/cash_bg"
                                    app:layout_constraintBottom_toTopOf="@id/textCashOption"
                                    app:layout_constraintDimensionRatio="1:1"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintWidth_percent="0.6" />

                                <TextView
                                    android:id="@+id/textCashOption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:text="Tiền mặt"
                                    android:textColor="@color/black"
                                    android:textSize="20dp"
                                    android:textStyle="bold"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@id/imgCashOption" />
                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </androidx.cardview.widget.CardView>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>