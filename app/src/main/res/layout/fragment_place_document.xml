<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardViewStep2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Header with progress bar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:padding="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvDocumentTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Đặt giấy tờ"
                android:textColor="@android:color/black"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/progressBarContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintHorizontal_weight="1.5" />

            <View
                android:id="@+id/trackLine"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:background="@android:color/darker_gray"
                app:layout_constraintStart_toStartOf="@+id/progressBarContainer"
                app:layout_constraintEnd_toEndOf="@+id/progressBarContainer"
                app:layout_constraintTop_toTopOf="@+id/progressBarContainer"
                app:layout_constraintBottom_toBottomOf="@+id/progressBarContainer"
                app:layout_constraintVertical_bias="0.3" />

            <View
                android:id="@+id/progressLine"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:background="@android:color/holo_red_light"
                app:layout_constraintStart_toStartOf="@+id/progressBarContainer"
                app:layout_constraintTop_toTopOf="@+id/progressBarContainer"
                app:layout_constraintBottom_toBottomOf="@+id/progressBarContainer"
                app:layout_constraintVertical_bias="0.3"/>

            <!-- 8-step progress -->
            <LinearLayout
                android:id="@+id/progressBarContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvDocumentTitle"
                app:layout_constraintHorizontal_weight="2">

                <!-- Step 1 -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_marginBottom="4dp" android:background="@drawable/circle_redtick" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Chọn giấy tờ" android:textSize="10sp" android:textColor="@color/black" />
                </LinearLayout>

                <!-- Step 2 -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_marginBottom="4dp" android:background="@drawable/circle_redtick" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Đặt giấy tờ" android:textSize="10sp" android:textColor="@color/black" />
                </LinearLayout>

                <!-- Step 3 -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_marginBottom="4dp" android:background="@drawable/circle_border1" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Chụp ảnh trước" android:textSize="10sp" android:textColor="@color/black" />
                </LinearLayout>

                <!-- Step 4 -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_marginBottom="4dp" android:background="@drawable/circle_border1" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Chụp ảnh sau" android:textSize="10sp" android:textColor="@color/black" />
                </LinearLayout>

                <!-- Step 5 -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_marginBottom="4dp" android:background="@drawable/circle_border1" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Quét chip" android:textSize="10sp" android:textColor="@color/black" />
                </LinearLayout>

                <!-- Step 6 -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_marginBottom="4dp" android:background="@drawable/circle_border1" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Chân dung" android:textSize="10sp" android:textColor="@color/black" />
                </LinearLayout>

                <!-- Step 7 -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_marginBottom="4dp" android:background="@drawable/circle_border1" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Thanh toán" android:textSize="10sp" android:textColor="@color/black" />
                </LinearLayout>

                <!-- Step 8 -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_marginBottom="4dp" android:background="@drawable/circle_border1" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Khảo sát" android:textSize="10sp" android:textColor="@color/black" />
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Nội dung chính -->
        <LinearLayout
            android:id="@+id/cardContent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#FFEEEE"
            android:orientation="vertical"
            android:padding="32dp"
            app:layout_constraintTop_toBottomOf="@id/cardHeader"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvInstruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="26sp"
                android:textStyle="bold"
                android:text="@string/place_document_title"
                android:lineSpacingExtra="4dp" />

            <ImageView
                android:id="@+id/imgIllustration"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:contentDescription="@string/doc_placement_desc"
                android:src="@drawable/ic_cccd_placement" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
